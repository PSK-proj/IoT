    {
        "id": "3aa1290ff2c2a6bc",
        "type": "function",
        "z": "3f5eba95e9beea2c",
        "name": "Metrics → chart + text",
        "func": "var m = msg.payload || {};\nvar mode = flow.get(\"currentMode\") || \"UNKNOWN\";\nvar now = new Date().toISOString();\nvar p50 = Number(m.p50_ms);\nvar p95 = Number(m.p95_ms);\nvar count = Number(m.count);\nvar ts = m.ts_utc || now;\nvar text = \"Mode: \" + mode +\n           \" | p50: \" + (isNaN(p50) ? \"-\" : p50.toFixed(1)) + \" ms\" +\n           \" | p95: \" + (isNaN(p95) ? \"-\" : p95.toFixed(1)) + \" ms\" +\n           \" | n=\" + (isNaN(count) ? \"-\" : count) +\n           \" | ts=\" + ts;\nflow.set(\"lastMetrics\", { mode: mode, p50_ms: p50, p95_ms: p95, count: count, ts: ts });\nvar msgs = [];\nif (!isNaN(p50)) { msgs.push({ payload: p50, topic: \"p50_ms\" }); }\nif (!isNaN(p95)) { msgs.push({ payload: p95, topic: \"p95_ms\" }); }\nvar uiTextMsg = { payload: text };\nreturn [msgs, uiTextMsg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 380,
        "wires": [
            [

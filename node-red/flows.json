    {
        "id": "ea06553e7da6fa70",
        "type": "function",
        "z": "3f5eba95e9beea2c",
        "name": "Telemetry → chart",
        "func": "var t = msg.payload || {};\nvar seq = Number(t.seq);\nif (isNaN(seq)) { return null; }\nmsg.topic = t.device || \"device\";\nmsg.payload = seq;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,

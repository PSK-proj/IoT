    {
        "id": "95082b91dd269129",
        "type": "function",
        "z": "3f5eba95e9beea2c",
        "name": "Set mode & publish control",
        "func": "var payload = msg.payload;\nif (typeof payload === \"string\") {\n    var m = payload.match(/MODE\\s*=\\s*(PLAIN|TLS|MTLS)/i);\n    if (m) {\n        var mode = m[1].toUpperCase();\n        flow.set(\"currentMode\", mode);\n        var uiMsg = { payload: mode };\n        return [msg, uiMsg];\n    }\n}\nreturn [null, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 200,
        "wires": [
            [
                "bf6efb4d8d4b0709"
            ],
            [
                "eecb41822cf22687"
            ]
        ]

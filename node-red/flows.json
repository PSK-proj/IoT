    {
        "id": "6df8089dd6c62968",
        "type": "function",
        "z": "3f5eba95e9beea2c",
        "name": "Telemetry → last msg text",
        "func": "var t = msg.payload || {};\nvar mode = flow.get(\"currentMode\") || \"UNKNOWN\";\nvar text = \"Device: \" + (t.device || \"device\") +\n           \" | seq=\" + (t.seq != null ? t.seq : \"?\") +\n           \" | ts=\" + (t.ts_utc || \"?\") +\n           \" | mode=\" + mode;\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,

COMPOSE_PROJECT_NAME=iot

# Default mode (PLAIN | TLS | MTLS)
MQTT_MODE_DEFAULT=PLAIN

# Control topic
MQTT_CONTROL_TOPIC=lab/control

# Broker - PLAIN
MQTT_PLAIN_HOST=broker
MQTT_PLAIN_PORT=1883

# Broker - TLS
MQTT_TLS_HOST=broker
MQTT_TLS_PORT=8883
MQTT_TLS_CA=/certs/ca.crt

# Broker - mTLS
MQTT_MTLS_HOST=broker
MQTT_MTLS_PORT=8884

# Optional credentials (if password_file enabled)
MQTT_USERNAME=
MQTT_PASSWORD=

# QoS (0 | 1 | 2)
MQTT_QOS=0

# Publisher
PUB_DEVICE_NAME=publisher-1
PUB_HEARTBEAT_SEC=1.0
# if empty -> lab/telemetry/<PUB_DEVICE_NAME>
MQTT_TOPIC_PUB=

# Subscriber
SUB_DEVICE_NAME=subscriber-1
SUB_HEARTBEAT_SEC=1.0
MQTT_TOPIC_SUB=lab/telemetry/#
MQTT_TOPIC_METRICS=lab/metrics
